# Gemini API キー（シナリオコンバーター専用）
# TRPG 本体（streamlit run app.py）では読み込みません。
#
# セットアップ:
#   copy gemini.env.example gemini.env   (Windows)
#   cp gemini.env.example gemini.env     (Linux/macOS)
# その後 gemini.env に実際のキーを記入してください。
#
# このファイル（gemini.env）は Git にコミットしないでください。

GOOGLE_API_KEY=ここにAPIキーを貼り付け
# GEMINI_API_KEY=   # GOOGLE_API_KEY の別名（どちらか一方で可）
# GEMINI_MODEL=gemini-2.5-flash
