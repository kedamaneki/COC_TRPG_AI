# ローカル LLM（Ollama / OpenAI 互換 API）接続設定サンプル
# 使い方:
#   1. このファイルを同じフォルダに secrets.toml としてコピー
#   2. Ollama を起動: ollama serve
#   3. モデルを取得: ollama pull qwen2.5:14b
#   4. secrets.toml は Git にコミットしないこと
#
#   cp secrets.toml.example secrets.toml   (Linux/macOS)
#   copy secrets.toml.example secrets.toml (Windows)
#
# 環境変数でも同じキー名で上書き可能（LLM_BASE_URL など）

# OpenAI 互換 API のベース URL（Ollama デフォルト）
LLM_BASE_URL = "http://localhost:11434/v1"

# API キー（Ollama は任意の文字列で可。LM Studio / vLLM は各サービスのキー）
LLM_API_KEY = "ollama"

# PL（プレイヤーAI）用モデル名
LLM_PL_MODEL = "qwen2.5:14b"

# KP（ゲームマスターAI）用モデル名
LLM_KP_MODEL = "qwen2.5:14b"

# 接続タイムアウト（秒）
LLM_TIMEOUT = "120"

# 1応答の最大生成トークン（小さすぎると KP JSON が途中切れする）
LLM_MAX_TOKENS = "2048"

# ※ Gemini API キーはここには書かないでください（TRPG本体は未使用）。
#    シナリオコンバーター用: src/.local/gemini.env を参照
