      "presentation_order": 7.5,
      "presentation_origin": null,
      "prompt_grounding": null,
      "prompt_grounding_source_event_ids": [],
      "reorder_reason": "WORLD_EVENT_BEFORE_SAN",
      "resolved_display_name": "KP",
      "semantic_class": "WORLD_EVENT",
      "source_event_ids": [
        "norm:session:000313",
        "session_log:000313"
      ],
      "source_script_line_id": "scene_048_script_009",
      "speaker_context": {
        "pc_id": null,
        "player_id": null,
        "resolution": "CURRENT_MAPPING_FALLBACK",
        "resolved_display_name": "KP",
        "resolved_portrait_profile_id": null,
        "resolved_subtitle_profile_id": "subtitle_kp",
        "resolved_voice_profile_id": "m1_vv_kp",
        "speaker_mode": "UNKNOWN"
      },
      "speaker_id": "kp",
      "subtitle_profile_id": "subtitle_kp",
      "system_interaction_id": null,
      "text": "古いナイフは一瞬の静寂を破り、探索者のエレノア教授を恐怖の渦に巻き込んだ。その刃は鮮明なサビの下に隠された血痕と、過去の犠牲者の呪いを秘めている。教授の手から離れたダガーは、静電気のような光を放ちながら、空中を縫って教授を襲い、その恐怖はエレノア教授の心を揺さぶる。恐らく、この一瞬は永遠のようだった。その恐怖が、あなたの正気を試す。",
      "voice_profile_id": "m1_vv_kp",
