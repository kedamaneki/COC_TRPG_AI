      "speaker_id": "pc_02",
      "subtitle_profile_id": "subtitle_marisa",
      "system_interaction_id": null,
      "text": "システム: エレノア教授 : 【技能:目星】CC(1d100<=50) ＞ 出目:59 ＞ 失敗\n【幸運消費】PLの意志により幸運を 9 消費し、regular 成功に書き換えた（残り幸運: 41）\nナイフを拾い上げると、ひとりでに探索者の手を振りほどいて宙に浮き上がり、攻撃してきた！\n【確定手がかり】古いもののようで、柄には装飾が施され、刃は異様に厚いサビで覆われている。これはコービットの魔法のダガーで、サビのように見えるのは付着した犠牲者の血が乾いたものだ。",
      "voice_profile_id": "aq_marisa_default",
      "voice_text": null
    },
    {
      "background_asset_id": "bg_neutral_user",
      "event_type": "KP_DESCRIPTION",
      "fixed_duration_sec": 3.2,
      "interaction_type": null,
      "narrative_role": null,
      "original_order": 12,
      "overlay": null,
      "pl_voice_fallback": null,
      "portrait_asset_id": null,
      "portrait_kind": null,
